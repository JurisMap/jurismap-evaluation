# Local JurisMap v2 server for evaluation runs (non-secret; secrets come from app/backend/.env).
# Process environment for app/backend, so these override config/runtime.env and .env there.
# Relative paths are relative to this repo.
EVAL_MODE=1
DATA_VERSION=v2
DATA_DIR=data/v2/rebuild_20261009
# Read-only runtime queries (API_get_filters, fallbacks) go to the frozen v2 table, never to crsnsp.
BIGQUERY_TABLE=your-gcp-project.crsnsp_eval.scraper_output_v2_1
# Filesystem sessions: never the production Redis configured in .env
SESSION_TYPE=filesystem
CLOUD_RUN=False
# Primary Gemini credentials (errors fall back to the fallback project's own credentials)
GEMINI_PRIMARY_CREDENTIALS=../primary-gemini-key.json
# Production defaults since backend 7e18139 (the frozen tag defaults to 2 / 300); billing only, same outputs
GEMINI_PRIMARY_RETRY_ATTEMPTS=6
GEMINI_PRIMARY_COOLDOWN_S=60
