%% JurisMap v2 (tag v2.2-eval-frozen, backend 4dce1ab): defense generation.
%% Google ADK 1.3.0 (agents_adk/workflow_coordinator.py, router_adk.py). All models gemini-3.7-flash (global endpoint).
flowchart TD
    IN[/"Request /API_generate_defense<br/>session: template, case file, case description,<br/>selected cases (≤ 10); eval flags: ablation_mode, case_hashes, skip_supervisor"/]
    SUP{"SupervisorAgent<br/>checks the inputs, answers JSON<br/><i>all agents: gemini-3.7-flash</i>"}
    ASK[/"clarification_needed:<br/>questions back to the user"/]

    subgraph SEQ ["SequentialAgent: JurisMapDefenseGenerationPipeline"]
        direction TB
        subgraph PAR ["ParallelAgent: ParallelResearchTeam (isolated branches)"]
            direction LR
            CI["CaseInterpreter<br/>→ state.case_analysis_result"]
            LS["LegalSearcher + Google Search grounding<br/>→ state.legal_search_result"]
            DS["DefenseStructureInterpreter<br/>→ state.structure_analysis_result"]
        end
        DC["DefenseCreator<br/>reads the three results (prompt + history)<br/>→ state.defense_creation_result"]
        MG["MergerAgent<br/>final draft (from history)"]
        PAR --> DC --> MG
    end

    FG["Fact guard (deterministic, utils/fact_guard.py)<br/>replaces unsupported case identifiers,<br/>flags unsupported dates, amounts, acts"]
    OUT[/"SSE stream: one message per agent event,<br/>'Verificação de Fatos', end message"/]

    IN --> SUP
    SUP -- "clarification_needed" --> ASK
    ASK -. "user answers (phase=clarification)" .-> SUP
    SUP -- "ready" --> PAR
    IN -. "skip_supervisor (EVAL_MODE=1)" .-> PAR
    MG --> FG --> OUT

    SP["single_prompt ablation: one call with all agent prompts<br/>concatenated + Google Search grounding"]
    IN -. "ablation_mode=single_prompt" .-> SP -.-> FG
    ABL["Ablations: no_legal_search → LegalSearcher skipped, fixed notice in state<br/>no_template → DefenseStructureInterpreter skipped, default structure in state<br/>no_precedents → no selected cases passed to any agent"]
    SP ~~~ ABL
